# OpenAI-compatible chat + embedding provider.
# The bundled index was built with bge-m3 (1024-d); if you change EMB_MODEL,
# rebuild the index or retrieval will fail on dimension mismatch.
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3-8B
EMB_MODEL=BAAI/bge-m3
DISABLE_THINKING=true

# Comma-separated API keys. Empty means /v1 endpoints fail closed with 503.
API_KEYS=dev-key-change-me
RATE_LIMIT_PER_MINUTE=60
MAX_STEPS=6

# Local paths. Docker overrides these to /app/data and /app/runs.
AGENTIC_RAG_DATA_DIR=./data
RUNS_DIR=./runs

ENVIRONMENT=dev
LOG_LEVEL=INFO
DOCS_ENABLED=true
